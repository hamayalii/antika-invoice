# ------------------------------------------------------------------
# Antika Docs — environment
# Copy to .env and edit. Never commit .env.
# ------------------------------------------------------------------

# PostgreSQL (docker-compose service is named "postgres")
POSTGRES_USER=antika
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=antika_docs
DATABASE_URL=postgresql://antika:change_me_strong_password@postgres:5432/antika_docs?schema=public

# API Configuration
NODE_ENV=production
# PORT is automatically injected by Railway or cloud platforms; API_PORT is the local/fallback port
PORT=4000
API_PORT=4000
# Public origin of the web app (used for CORS and cookies, e.g. https://antika-invoice.netlify.app)
APP_ORIGIN=https://antika-invoice.netlify.app
# Additional comma-separated allowed origins for CORS (optional)
CORS_ALLOWED_ORIGINS=https://antika-invoice.netlify.app,http://localhost:5173
# Public URL encoded in document QR codes (defaults to APP_ORIGIN)
PUBLIC_BASE_URL=https://antika-invoice.netlify.app
# Origin the API uses internally to render the print page for Puppeteer
WEB_BASE_URL=https://antika-invoice.netlify.app
# Optional A4-landscape printing for vouchers: A5_landscape | A4_landscape
VOUCHER_PAGE=A5_landscape

# Authentication — generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Document integrity HMAC; changing it marks existing documents as MODIFIED
DOC_HMAC_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=true
# Cookie SameSite policy: strict | lax | none (defaults to none in production with secure=true for cross-origin deployments)
COOKIE_SAME_SITE=none

# First admin (created by the seed, must change password on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!1234
ADMIN_FULL_NAME=Antika Administrator

# Deployment
DOMAIN=antika-invoice.netlify.app
# Set to 1 behind HTTPS (Railway, Netlify, nginx, Caddy) so Express trusts X-Forwarded-*
TRUST_PROXY=1

# Frontend (Vite / Netlify)
# Target backend API URL for frontend builds
VITE_API_URL=https://antika-invoice-production.up.railway.app
