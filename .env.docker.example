# Docker Compose environment — copy to .env.docker and run:
#   docker compose --env-file .env.docker up --build -d
# For a VPS replace DOMAIN/APP_ORIGIN with your real HTTPS domain.

POSTGRES_USER=antika
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=antika_docs

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
DOC_HMAC_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
JWT_EXPIRES_DAYS=7
COOKIE_SECURE=false
TRUST_PROXY=1

APP_ORIGIN=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
DOMAIN=localhost
WEB_PORT=8080

VOUCHER_PAGE=A5_landscape

ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!1234
ADMIN_FULL_NAME=Antika Administrator
